<?xml version="1.0" encoding="utf-8"?>
<!-- Данные Grind не уходят в облачные копии и не переносятся на другой телефон автоматически:
     новое устройство начинает с чистого листа, перенос — только вручную (Настройки → Экспорт / Импорт). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
